{
  "inspiration": "Calm — yoga warmth con sage greens y un toque ámbar",
  "vibe": "Calm",
  "palette": {
    "background": {
      "default": "#1a1f1c",
      "elevated": "#22282a",
      "subtle": "#2a302d"
    },
    "border": {
      "subtle": "rgba(245, 230, 211, 0.08)",
      "default": "rgba(245, 230, 211, 0.14)"
    },
    "text": {
      "primary": "#f5e6d3",
      "secondary": "#b8aa97",
      "muted": "#7a7060"
    },
    "brand": {
      "primary": "#84a59d",
      "secondary": "#f6bd60"
    },
    "feedback": {
      "success": "#7ba88f",
      "warning": "#f6bd60",
      "error": "#cb6a5a",
      "info": "#7299b8"
    }
  },
  "typography": {
    "body": "Inter",
    "display": "Fraunces",
    "mono": "JetBrains Mono",
    "scale": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "24px",
      "2xl": "32px",
      "3xl": "48px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px"
  },
  "radius": {
    "sm": "6px",
    "md": "12px",
    "lg": "20px",
    "xl": "28px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0,0,0,0.06)",
    "md": "0 4px 12px rgba(0,0,0,0.10)",
    "lg": "0 12px 28px rgba(0,0,0,0.14)"
  },
  "motion": {
    "duration": {
      "fast": "180ms",
      "base": "320ms",
      "slow": "500ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  }
}
