// Atelier v2 — generated Prisma schema. The Persistence agent fills in models
// per feature. Output goes to a SHARED location so multiple features can
// import from the same generated client.

generator client {
  provider = "prisma-client"
  output   = "../src/_shared/infrastructure/db/generated"
}

// Prisma 7: the connection URL lives in prisma.config.ts (datasource.url),
// NOT here. Schema-level `url = env(...)` was removed in Prisma 7.
datasource db {
  provider = "postgresql"
}

// Anchor model so `prisma generate` succeeds against an empty schema.
// The Persistence agent will add per-feature models alongside.
model User {
  id        String   @id @default(cuid())
  slug      String   @unique
  email     String   @unique
  role      String
  isActive  Boolean  @default(true)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
