# --- Database ---
DATABASE_URL=postgresql://atelier:atelier@localhost:5433/atelier

# --- Stitch (visual design) ---
# ATELIER_STITCH_MODE controls how layout-architect (wave-2-design) gets its
# visual design.  Default = fixture:yoga (deterministic, no quota burn).
#
# Values:
#   fixture:yoga  Use fixtures/stitch-yoga.json -- deterministic demo, no
#                 quota burn.  STITCH_API_KEY NOT required.  (default)
#   fixture       Use the fixture at ATELIER_STITCH_FIXTURE.  Falls back
#                 to fixture:yoga if path is empty or file is missing.
#                 STITCH_API_KEY NOT required.
#   live          Invoke Stitch MCP for real designs.  Requires
#                 STITCH_API_KEY + free-tier quota (350 designs/mo).
# ATELIER_STITCH_MODE=fixture:yoga
# ATELIER_STITCH_FIXTURE=
# STITCH_API_KEY=                 # required ONLY when ATELIER_STITCH_MODE=live

# --- Atelier runtime ---
# ATELIER_TIMEOUT_MULTIPLIER=1.0

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
