# =============================================================================
# Atelier -- environment variables
# Copy to .env and fill in the values marked REQUIRED.
# =============================================================================

# -- Database ------------------------------------------------------------------
# Matches the docker-compose.yml defaults. Change only if you run Postgres
# on a different host/port.
DATABASE_URL=postgresql://atelier:atelier@localhost:5432/atelier?schema=public

# -- Clerk (REQUIRED for auth) -------------------------------------------------
# Get these from https://dashboard.clerk.com -> your app -> API Keys.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# -- Agent runtime -------------------------------------------------------------
# ANTHROPIC_API_KEY is read by the claude CLI subprocess each agent spawns.
# Set it here so pnpm dev picks it up.
ANTHROPIC_API_KEY=

# Stitch design-system SDK (optional -- only needed for visual-adapter agent).
STITCH_API_KEY=

# Absorb systemic slowness: multiply all agent timeouts by this factor.
# Default is 1.0 (no change). Increase on slow machines or VMs (e.g. 1.5).
ATELIER_TIMEOUT_MULTIPLIER=1.0

# -- Postgres override (optional) ----------------------------------------------
# If port 5432 is already in use, change this and update DATABASE_URL above.
# POSTGRES_HOST_PORT=5432
