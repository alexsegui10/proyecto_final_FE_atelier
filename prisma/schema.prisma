// Atelier — Prisma schema (PRD §5)
// Do not edit field names without updating the agents that consume this.

generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String    @id // Clerk id
  email    String    @unique
  projects Project[]
}

model Project {
  id          String       @id @default(cuid())
  slug        String       @unique
  userId      String
  name        String
  prd         Json
  createdAt   DateTime     @default(now())
  generations Generation[]
  user        User         @relation(fields: [userId], references: [id])
}

model Generation {
  id         String     @id @default(cuid())
  projectId  String
  status     String // pending | running | complete | failed
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  result     Json?
  agentRuns  AgentRun[]
  events     Event[]
  project    Project    @relation(fields: [projectId], references: [id])
}

model AgentRun {
  id           String     @id @default(cuid())
  generationId String
  agent        String // architect | domain | use-cases | auth | api-frontend | qa
  status       String // idle | working | done | failed
  startedAt    DateTime?
  finishedAt   DateTime?
  output       Json?
  generation   Generation @relation(fields: [generationId], references: [id])
}

model Event {
  id           String     @id @default(cuid())
  generationId String
  ts           DateTime   @default(now())
  type         String // agent.started | agent.thinking | agent.file | agent.handoff | agent.completed | qa.fail | done
  payload      Json
  generation   Generation @relation(fields: [generationId], references: [id])
}
